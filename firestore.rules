rules_version = '2';

// Security rules for the class leaderboard.
//
// BEFORE PASTING INTO FIREBASE (Firestore Database > Rules):
//   1. Replace school-domain.example with your school email domain: the part after the @ (lower case).
//   2. Replace teacher@school-domain.example with your own school email address (lower case).
// Those two values live only in Firebase. Don't commit them back to GitHub.
//
// What these rules allow:
//   - Only people signed in with a Microsoft account on the school's email domain can read or write.
//   - Each student can only create, update or delete their own entry.
//   - An entry holds just: first name + surname initial, XP, level, last update time, this week's XP.
//   - The name must match the name on the student's school account.
//   - XP can't go down, can only rise by 3,000 per upload, and uploads must be 15+ seconds apart.
//   - The teacher account can remove any entry.

service cloud.firestore {
  match /databases/{database}/documents {

    function school() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email is string
        && request.auth.token.email.lower().split('@')[1] == 'school-domain.example';
    }

    function teacher() {
      return school() && request.auth.token.email.lower() == 'teacher@school-domain.example';
    }

    // "Amira K." - the first name must appear in the name on the school account
    function validName(n) {
      return n is string && n.size() <= 24
        && n.matches("^\\p{Lu}[\\p{L}'-]{0,19}( \\p{Lu}[.])?$")
        && request.auth.token.name is string
        && request.auth.token.name.lower().matches("(.*[^\\p{L}])?" + n.split(' ')[0].lower() + "([^\\p{L}].*)?");
    }

    function validEntry(d) {
      return d.keys().hasOnly(['name', 'xp', 'lvl', 'upd', 'wk'])
        && d.keys().hasAll(['name', 'xp', 'lvl', 'upd', 'wk'])
        && validName(d.name)
        && d.xp is int && d.xp >= 0 && d.xp <= 400000
        && d.lvl is int && d.lvl >= 1 && d.lvl <= 80
        && d.upd == request.time
        && d.wk is map && d.wk.size() == 1
        && d.wk.keys()[0].matches('^w[0-9]{8}$')
        && d.wk.values()[0] is int && d.wk.values()[0] >= 0 && d.wk.values()[0] <= d.xp;
    }

    // this week's XP can only rise by as much as total XP has risen
    function weekOk(old, nw) {
      return nw.wk.values()[0] <= nw.xp - old.xp
        + (nw.wk.keys()[0] in old.wk ? old.wk[nw.wk.keys()[0]] : 0);
    }

    match /board/{uid} {
      allow read: if school();
      allow create: if school() && request.auth.uid == uid && validEntry(request.resource.data);
      allow update: if school() && request.auth.uid == uid
        && validEntry(request.resource.data)
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 3000
        && request.time > resource.data.upd + duration.value(15, 's')
        && weekOk(resource.data, request.resource.data);
      allow delete: if school() && (request.auth.uid == uid || teacher());
    }

    // nothing else in the database can be read or written
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
